{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/content-guard.mjs\"",
            "timeout": 30,
            "statusMessage": "Vérification contenu avant commit/push/PR"
          }
        ]
      }
    ]
  }
}
